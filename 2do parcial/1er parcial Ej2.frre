//! Ejercicio de parcial 2025 - Tema b - Pto 2
//* Clase 24/06/2026
// CORTE DE CONTROL

/*
	 Ejercicio Nº 2

	 La red de estaciones de carga urbana para vehículos eléctricos (VE) dispone de un sistema de monitoreo que registra las sesiones de carga realizadas durante el mes de JUNIO. La información se encuentra ordenada por Número de Estación, Tipo de Vehículo, y Número de Carga, y para cada sesión de carga se registra:

	 | Nro. de Estación | Tipo de Vehículo (SD, SV, UT) | Nro. Carga | Fecha de carga | Duración carga (minutos) | Costo carga |

	 Nota:  SD: Sedan,  SV: SUV  y  UT: Utilitario

	 Se pide escribir un algoritmo para:
	 a) Listar todas las cargas de la quincena.
	 b) Mostrar el total recaudado por estación y por tipo de vehículo.
	 c) Crear un archivo de salida que contenga, por cada estación:
		 Número de Estación
		 Total recaudado en vehículos tipo UTILITARIO
	 d) Informar cuáles son las estaciones que tuvieron mayor recaudación en vehículos tipo SEDAN que en vehículos tipo UTILITARIO.
*/

// Solo 2 cortes por registro, en nro_estacion y tipo_vehiculo
Accion ej2 es
	AMBIENTE
		FECHA = registro
			dd: 1..31
			mm: 1..12
			aa: 2000..2090 //o N(4)
		fin_registro
		
		//ARCHIVO A PROCESAR
		Estacion = registros
			nro_estacion: N(2)
			tipo_vehiculo: ("SD", "SV", "UT")   
			nro_carga: N(4)
			fecha: FECHA
			duracion: 1..60
			costo: Real
		fin_registro
		
		ARCH_ESTACION: Archivo de Carga ordenado por nro_estacion, tipo_vehiculo, nro_carga
		REG_ESTACION: Estacion
		
		//ARCH SALIDA
		Recaudacion = registro
			nro_estacion: N(2)
			total_ut: N(4,2)
		fin_registro
		
		A_SAL: archivo de Recaudacion
		R_SAL: Recaudacion

		//Totalizadores
		Tot_Vehiculo: real
		Tot_Estacion: real
		Tot_UT_Estacion: real
		Tot_SD_Estacion: real

		//Resguardos:
		res_nro_estacion: N(2)
		res_vehiculo: ("SD", "SV", "UT")


		PROCEDIMIENTO INICIALIZAR() ES
			Tot_Vehiculo := 0
			Tot_Estacion := 0
			Tot_UT_Estacion := 0
			Tot_SD_Estacion := 0

			res_estacion := REG_ESTACION.nro_estacion
			res_vehiculo := REG_ESTACION.tipo_vehiculo
		FIN_PROCEDIMIENTO
		
		PROCEDIMIENTO CORTE_VEHICULO() ES
			//"Listar" = escribir
			ESC("VEHICULO: ", res_vehiculo)
			ESC("Total recaudado en la estación ", res_nro_estacion, ": $", Tot_Vehiculo)

			Tot_Estacion := Tot_Estacion + Tot_Vehiculo

			SI res_vehiculo = "SD" ENTONCES
				Tot_SD_Estacion := Tot_Vehiculo
				//No hace falta acumular porque de todos modos se vuelve a cero en CORTE_ESTACION. Y hay solo un grupo de SD, está ordenado por nro_estacion, tipo_vehiculo, nro_carga.
			SINO 
				SI res_vehiculo = "UT" ENTONCES
					Tot_UT_Estacion := Tot_UT_Estacion + Tot_Vehiculo
				FIN_SI
			FIN_SI

			Tot_Vehiculo := 0

			res_vehiculo := REG_ESTACION.tipo_vehiculo
		FIN_PROCEDIMIENTO
		
		
		PROCEDIMIENTO CORTE_ESTACION() ES
			CORTE_VEHICULO()
			ESC("ESTACION: ", res_nro_estacion)
			ESC("Total general recaudado: $", Tot_Estacion)

			R_SAL.nro_estacion := res_nro_estacion
			R_SAL.total_ut := Tot_UT_Estacion
			ESC(ARCH_SAL, REG_SAL)
						
			
			SI Tot_SD_Estacion > Tot_UT_Estacion ENTONCES
				ESCRIBIR("La estación ", res_nro_estacion, " tuvo mayor recaudación en vehículos SEDAN que es UTILITARIOS.")
			FIN_SI
			
			Tot_Estacion := 0
			Tot_UT_Estacion := 0
			Tot_SD_Estacion := 0

			res_nro_estacion := REG_ESTACION.nro_estacion
		FIN_PROCEDIMIENTO
		
	PROCESO
		//Inicializar_archivos
    ABRIR E/(ARCH_ESTACION)
	ABRIR /S(ARCH_SAL)
	LEER(ARCH_ESTACION, REG_ESTACION)

	INICIALIZAR()
    
    MIENTRAS NoFDS(ARCH_ESTACION) HACER
    	SI res_nro_estacion <> REG_ESTACION.nro_estacion ENTONCES
			CORTE_ESTACION()
		SINO
			SI res_vehiculo <> REG_ESTACION.VEHICULO ENTONCES
				CORTE_VEHICULO()
			FIN_SI
		FIN_SI

		//Verificar QUINCENA 
		SI REG_ESTACION.fecha.dd <= 15 ENTONCES
			ESCRIBIR("Carga en 1ra quincena")
			ESCRIBIR("| Estación: ", REG_ESTACION.nro_estacion, "| Vehiculo: ", REG_ESTACION.tipo_vehiculo, "| Fecha: ", REG_ESTACION.fecha.dd, "-", REG_ESTACION.fecha.mm)
		FIN_SI

		Tot_Vehiculo := Tot_Vehiculo + REG_ESTACION.costo

		LEER(ARCH_ESTACION, REG_ESTACION)
  	FIN_MIENTRAS

	CORTE_ESTACION()

	CERRAR(ARCH_ESTACION)
	CERRAR(ARCH_SAL)

FIN_ACCION



  	