/*
Ejercicio 3.4
Considerando un arreglo de 50 números enteros, confeccione un algoritmo para resolver las siguientes consignas:

    Modificar el arreglo dado, de modo que todos sus elementos sean múltiplos de 3.
    Crear otro arreglo que contenga los números que no cumplieron la condición.
    Informar cuántos números cumplieron la condición.

*/

//Este hice yo.
Accion Ej3_4(A: arreglo de [1..50] de entero) es
AMBIENTE
	i, j, cont3: entero

	Sal: arreglo de [1..50] de entero
	
PROCESO
	//Inicializar variables
	cont3 := 0
	//Inicializar arreglo salida
	Para j := 1 hasta 50 hacer
		sal[j] := 0
	Fin_para

	j := 1

	Para i := 1 hasta 50 hacer
		Si A[i] MOD 3 = 0 entonces
			cont3 := cont3 + 1
		Sino
			Sal[j] := A[i]
			j := j+1   //Ahora nuestra salida queda ordenada y los espacios "vacios"(que en este caso como inicialicé no son indefinidos sino que valen 0) quedan al final.
			A[i] := A[i]*3
		Fin_si
	Fin_para

	Escribir("Cumplieron la condición", cont3, "números de 50.")

Fin_accion