//! Ejercicio de parcial
// 23/09/2026 (clase)


Accion estadistica es 
  Ambiente 
    Fecha = registro 
      año: n(4)
      mes: n(2)
      dia: n(2)
    finreg 

    novedades = registro 
      tipo_equipo: an(15)
      nro_equipo: n(4)
      tipo_novedad: 1..3
      fe_novedad: fecha 
      hora_inicio: real
      hora_fin: real 
      nro_circuito: 1..6
      id_usuario: n(6)
    finreg

    usuario = registro 
      id_usuario: n(6)
      DNI: n(8)
      sexo: ("m","f")
      apy_nom: an(30)
      lugar_origen: 1..4
      edad: entero 
    finreg

    arch_nov: archivo de novedades ordenado por tipo_equipo, nro_equipo, tipo_novedad y fe_novedad
    reg_nov: novedades 
    arch_usuario: archivo de usuario indexado por id_usuario 
    reg_usuario: usuario 
    
    cant: arreglo de [1..7, 1..4] de entero 
    porcent: arreglo de [1..6] de real
    i, j, pos_max: entero

    procedimiento inicializar () es 
      para i:= 1 hasta 7 hacer 
        para j:= 1 hasta 4 hacer 
          cant[i,j]:= 0
        finpara
      finpara 
      para i:= 1 hasta 6 hacer 
        porcent[i]:= 0
      finpara 
    finprocedimiento 

    procedimiento mostrar_totales () es 
      escribir ("/       / 18 a 25 años / 26 a 30 años / mas 30 años / totales x circuito/")
      para i:= 1 hasta 7 hacer 
        si i < 7 hacer 
          escribir (i)
        sino 
          escribir ("totales x rango de edad")
        finsi
        para j:= 1 hasta 4 hacer 
          escribir (cant[i,j])
        finpara 
      finpara 
    finprocedimiento 

    procedimiento edad () es 
      si reg_usuario.edad > 17 y reg_usuario.edad < 26 entonces 
        j:= 1
      sino 
        si reg_usuario.edad > 25 y reg_usuario.edad < 31 entonces 
          j:= 2 
        sino 
          j:= 3
        finsi 
      finsi

			/* 
			//Yo
			Si reg_usuario.edad < 31 entonces
				Si reg_usuario.edad > 25 entonces //26-30
					j := 2
				Sino si reg_usuario.edad > 17 entonces //18-25
					j := 1
				si_no
			Sino
				Si reg_usuario.edad > 31 entonces //+30
					j := 3
				Sino		//<18
					//no
				Fin_si
			Fin_si					
				
			*/
    finprocedimiento 

    procedimiento porcentaje () es 
      pos_max:= 1
      para i:= 1 hasta 6 hacer 
        porcent[i]:= (cant[i,4]/cant[7,4]) * 100 
        si porcent[i] > porcent[pos_max] entonces 
          pos_max:= i 
        finsi 
      finpara 
    finrpocedimiento 

  proceso 
    abrir e/ (arch_nov); leer (arch_nov, reg_nov)
    abrir e/ (arch_usuario)
    inicializar ()
    mientras NFDA (arch_nov) hacer 
      si reg_nov.tipo_novedad = 2 entonces 
			
        reg_usuario.id_usuario:= reg_nov.id_usuario 
        leer (arch_usuario, reg_usuario)
				
        si existe entonces 
          i:= reg_nov.nro_circuito
          edad () //acá defino edad
					
          cant[i,j]:= cant[i,j] + 1 
          cant[i,4]:= cant[i,4] + 1
          cant[7,j]:= cant[7,j] + 1 
          cant[7,4]:= cant[7,4] + 1
					
        sino 
          escribir ("error el usario no existe")
					
        finsi 
      finsi 
			
      leer (arch_nov, reg_nov)
    finmientras 
		
    mostrar_totales ()
    porcentaje ()
		
    cerrar (arch_nov); cerrar (arch_usuario)
finaccion










