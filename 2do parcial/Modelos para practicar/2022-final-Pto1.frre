//! Ejercicio de parcial, final 2022
// 23/09/2026 (clase)


/*
*  PROBLEMA 1

  Trabajando como programadores en una reconocida empresa de desarrollo de Software, nos solicitan realizar una rutina con la cual se podrá obtener una estadística sobre los errores encontrados en sus programas en un determinado año.

  Para ello nos brindan un listado ya cargado de los 50 códigos de errores posibles con su respectiva descripción, teniendo la siguiente estructura:

  - Código de error: 8 caracteres
  - Descripción del Error: 30 caracteres

  Además nos dan un archivo llamado LogErrores con el siguiente diseño de registro:
    - Fecha: 10 caracteres
    - Código Error: 8 caracteres


  La información almacenada en este archivo:
    - ya se encuentra validada
    - no tiene ningún orden lógico
    - puede contener la información de más de un año.


  Contamos con un procedimiento desarrollado por otro área al cual pasándole por parámetro una fecha, nos devuelve un registro con 3 campos enteros (Dia, Mes y Año). Este procedimiento no debe ser desarrollado, solo ser invocado cuando corresponda.

  Se pide:
    a) Desarrollar un algoritmo que reciba como parámetro los 50 Códigos de Error y el año que se desea procesar. Procese los datos del archivo LogErrores y genere 2 archivos nuevos, uno llamado NoProcesados que contendrá aquellos registros que no son del año solicitado para la estadística con el mismo diseño de registro que el archivo LogErrores. Y Otro llamado Totales con el siguiente diseño de registro:

      Mes: Entero (1 a 12)
      Código de Error: 8 caracteres
      Cantidad de Errores: Entero

    b) A partir del archivo Totales y los 50 Códigos de Error, informar:
      b.1) Códigos de error no informados por mes
      b.2) Mes con mayor cantidad de errores
      b.3) Cantidad de errores registrados en total


* NOTAS ----------------------------------------------
 	- Listado ya cargado de 50 códigos de errores(N(8)) + su descripción(AN(30))
 	- Archivo LogErrores con Fecha(dia, mes y año, usamos función fecha()), cod error(N(8))
 	- La información almacenada en este archivo:
 			- ya se encuentra validada
 			- no tiene ningún orden lógico
 			- puede contener la infor de más de un año

 . Si vamos a considerar el punto 2 un corte de control entonces no necesitamos los totalizadores (totales = registro ), pero no podemos porque no está ordenado.



 CÓMO USAR LA FUNCION FECHA()
 	o cuálquier funció predefinida, que yo no necesite desarrollar.
 	func fecha devuelve un registro completo(año, mes y día) 
	
 	fec := funcfecha(reg_log.fecha)
 	si (fec.año = año_ingresado) ....
 
*/

Accion parcial es 
  Ambiente 
  
    //ERRORES-----------------------------------
    error = registro 
      cod_error: an(8)
      descripcion: an(30)
    fin_reg

    lista: arreglo de [1..50] de error 	


    //FECHAS-----------------------------------
    logErrores = registro 
      fecha: an(10)
      cod_error: an(8)
    fin_reg

    arch_log, no_procesados: archivo de logErrores 
    reg_log: logErrores 
    reg_nopro: logErrores //salida, no procesados b)

    //TOTALES-----------------------------------
    totales = registro 
      mes: 1..12
      cod_error: an(8)
      cant_error: entero 
    fin_reg

    arch_tot: archivo de totales 
    reg_tot: totales 

    //Matriz -------
    T: arreglo de [1..13, 1..51] de entero 
    i: 1..13 //mes
    j: 1..51 //cod error
    pos_max: entero
    aux: an(8)
    año_ingresado: n(4)

		//Inicializa la matriz
    Procedimiento Inicializar_Matriz() es 
      para i:= 1 hasta 13 hacer 
        para j:= 1 hasta 51 hacer 
          T[i,j]:= 0
        finpara 
      finpara 
    finprocedimiento 

		//Busqueda con centinela
    Procedimiento busqueda() es 
      i:= 1; 
			aux:= reg_log.cod_error
			
      Mientras (i<50) y (lista[i].cod_error <> aux) hacer 
        i:= i+1 
      finmientras 
			
      Si lista[i].cod_error = aux entonces 
        j:= i 
      Sino
        j:= 0
      finsi 
    finprocedimiento 


	PROCESO
    ABRIR E/ (arch_log); leer (arch_log, reg_log)
    ABRIR /S (arch_tot); 
		ABRIR /S (no_procesados)
		
    Inicializar_Matriz()
		
    escribir("Ingrese el año a procesar")
    leer(año_ingresado)

		//Bucle principal
    Mientras NFDA(arch_log) hacer 

			//Función dada por el enunciado, funcfecha devuelve un registro fecha(dia, mes, fecha: entero)
			fec := funcfecha(reg_log.fecha)
			
      Si (fec.año = año_ingresado) entonces 
        i := fec.mes 
				
        busqueda() //buscamos el cod_error del reg_log actual.
				
        //Guardamos en una MATRIZ ----------
          //i: mes fila  ;  j: cod error colummna
        Si j <> 0 entonces 
          T[i,j] := T[i,j] + 1
          T[i,51] := T[i,51] + 1
          T[13,j] := T[13,j] + 1
          T[13,51] := T[13,51] + 1
        fin_si
				
      Sino 
        //b)  cod no informados por mes
        reg_nopro := reg_log
				
        escribir(no_procesados, reg_nopro)
      fin_si 
			
      leer(arch_log, reg_log)
    fin_mientras 

		
    Para i:= 1 hasta 12 hacer //No quierop las columnas y filas de totales
      Para j:= 1 hasta 50 hacer 
        Si T[i,j] <> 0 entonces 
          reg_tot.mes := i 
          reg_tot.cod_error := lista[j] //lista de errores
          reg_tot.cant_error := T[i,j]

          escribir(arch_tot, reg_tot)

        Sino 
          escribir("el codigo de error", lista[j], "no fue informado para el mes de", i)
        fin_si 
      fin_para 
    fin_para 
    

    //b) algoritmo de Ordenamiento seleccion
    Para i:= 1 hasta 12 hacer 
      pos_max := 1 //posición máxima
      
      Si T[i,51] > T[pos_max,51] entonces 
        pos_max:= i
      fin_si 
    fin_para

    escribir (" el mes con mayor cantidad de errores es", pos_max)
    escribir ("la cantidad de errores registrados es de:", T[13,51])


    cerrar (arch_log); cerrar (arch_tot); cerrar (no_procesados)
finaccion 

        