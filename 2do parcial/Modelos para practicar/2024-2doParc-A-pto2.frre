//! Ejercicio 2 - Tema A - Com D - 2do parcial 2024
// Manejo de archivos indexado, procesos estadísticos y por tanto arreglos(matrices)

//* Revisar ej 3.26

/*
    Ejercicio N° 2  
    El banco ha solicitado un informe para conocer cómo se integra su cartera de clientes, agrupándolos por sucursal y categoría de cliente, a partir de los datos del archivo de CLIENTES (usar las estructuras de datos del ejercicio anterior). 

    Considerando que son 15 sucursales, y la información de las sucursales se encuentra en un archivo indexado:[Salto de ajuste de texto]Sucursales (indexado por id_sucursal)  

    id sucursal | nombre de la sucursal | direccion | localidad


    La estructura del informe solicitado es la siguiente: 

        Categoría diamante | Categoría oro | Categoría estándar | Totales por suc 
        Nombre sucursal 1  | 
        Nombre sucursal 2  | 
        …                  | 
        Nombre sucursal 15 | 
        Totales x categoría| 


        La categoría del cliente dependerá de los montos obtenidos en su saldo de la cuenta al último día del mes. 

            - Montos menores a $100.000 serán de categoría estándar. 
            - Montos menores a $1.500.000 serán de categoría oro. 
            - Montos superiores serán de categoría diamante. 

    Nota: no considerar clientes dados de baja. 
*/
 

 Accion ej2 es
    AMBIENTE
        FECHA = registro
            aa: N(4)
            mm: 1..12
            dd: 1..31
        Fin_registro

        clientes = registro
            id_sucursal: N(4)
            id_cliente: N(4)
            nom_apll: AN(30)
            saldo: real
            fecha_alta: FECHA
            fecha_baja: FECHA
        Fin_registro

		Aclie: archivo de clientes ordenado por id_sucursal, id_cliente
        clie: clientes

        sucursales = registro
            id_sucursal: N(4)
            nombre_suc: AN(30)
            direccion: AN(30)
            localidad: AN(30)
        Fin_registro

		Asuc: archivo de sucursales indexado por id_sucursal
		suc: sucursales

        tot: arreglo[1..16, 1..4] de entero
		i: 1..16 //filas
		j: 1..4 //columnas


    PROCESO
		Abrir E/(Aclie)
		Abrir E/S(Asuc) //entrada solo??

        LEER(Aclie)
        //LEER(Asuc)     Solo necesito abrir el archivo indexado, despues leo directamente el id_sucursal del registro que necesito usar.

        //Inicializo matriz
        Para i := 1 hasta 16 hacer
            Para j := 1 hasta 4 hacer
                tot[i,j] := 0
            fin_para
        fin_para

        //Guardar valores en el arreglo
        Mientras NoFDA(Aclie) hacer
            Si (clie.fecha_baja.aa <> 0) entonces
                i := clie.id_sucursal

                //Evaluo columnas
                Segun clie.saldo hacer
                    <100000: j := 3
                    <1500000: j := 2
                    otro: j := 1
                fin_segun
                
                //Cuento en la matriz
								//cada campo es un contador
                Tot[i,j] := Tot[i,j] + 1
                Tot[16,j] := Tot[16,j] + 1
                Tot[i,4] := Tot[i,4] + 1
                Tot[16,4] := Tot[16,4]  + 1
            Fin_si

            Escribir(Arch, reg)
        Fin_mientras


        //Imprimir en pantalla
        Escribir("Sucursales | Categoria diamante | Categoria oro | Categoria estándar | Totales por sucursal")
        Para (i:=1 hasta 16) hacer
            //Escribir titulos de columna de sucursales
            Si i < 16 entonces
                suc.id_sucursal := id
                Escribir(suc.nombre_suc)
            Sino
                Escribir("Totales por Categoria")
            fin_si
            
            //rellenar tabla
            Para (j:=1 hasta 4) hacer
                Escribir(tot[i,j])
            fin_para
        Fin_para

				Cerrar(Aclie)
				Cerrar(Asuc)
Fin_accion