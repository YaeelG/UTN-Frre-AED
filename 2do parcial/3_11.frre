//! Ejercicio 3.11
//* 02/09/2026

Accion busqueda ES
	AMBIENTE
		Pelicula = Registro
			Título: AN(50)
			Nombre: AN(50)
			Categoría: AN(25)
			Cantidad: N(5)
			Alquilado: "si", "no" 
		FinRegistro
		
		Aglo: Arreglo[1..100] de Pelicula  //Arreglo de registro
		cat: AN(25)
		i: Entero
		
	PROCESO
		Escribir("ingrese una categoria de pelicula")
		Leer(cat)
		Para i:= 1 Hasta 100 Hacer
			Si Aglo[i] = cat Entonces
				Escribir ('la pelicula', Aglo[i].Nombre, 'pertenece a la categoria', cat)
			FinSi
		FinPara
FinAccion