//! Ejercicio Modelo 1er Parcial 2025, Tema B

/*
* Ejercicio 1
    Durante la Feria del Libro se relevó información sobre las editoriales participantes y los libros que presentan. Los  datos fueron almacenados en dos secuencias de caracteres, las cuales deben ser procesadas para obtener distintos  informes. 
    
    Datos de Entrada 
    A. Secuencia de Editoriales: 
        Cada editorial está representada de la siguiente manera: 
            - Nombre de la editorial 
                (cantidad indeterminada de caracteres, finaliza con ‘&’) 
            - Provincia 
                (2 caracteres que representan un número del ‘01’ al ‘23’) 

            Ejemplo: Planeta&01Sudamericana&03... 
    
    B. Secuencia de Libros: 
        Por cada editorial hay una cantidad indeterminada de libros, separados por el carácter ‘@’. Cada libro contiene los  siguientes campos: 
            - Tema (1 carácter): 
                L = Literatura / 
                C = Ciencia / 
                A = Autoayuda y desarrollo personal / 
                I = Infantiles 
            - Cantidad de páginas: (3 caracteres, por ejemplo 245) 
            - Nombre del libro: (cantidad indeterminada de caracteres, finaliza con ‘&’) 
            - Resumen: texto libre (finaliza con el carácter ‘#’). 
            Las palabras están separadas por una cantidad variable de espacios en blanco. 

            Ejemplo: 
            L245Elprincipito&Una vida a vivir y aprender.#@C120FisicaParaTodos&Conceptos basicos para jovenes.#...  

    Se solicita escribir un algoritmo en pseudocódigo que permita: 

    a) Generar una secuencia de salida con los nombres de los libros de tema ‘Infantiles’ (tema = ‘I’) con menos de 150 páginas.
    b) Para cada editorial, informar la cantidad total de palabras utilizadas en todos los resúmenes.
    c) Indicar cuántas editoriales tienen al menos un libro del tema ‘Autoayuda’.

    En caso de ser necesario, escribir funciones auxiliares para convertir cadenas a números.
 


    Secuencias de Entrada
        Sec Editoriales
        Sec Libros

    a- Sec Salida -> LibInfantiles (<150pg)  
    b- Cant de palabras en resumen por Editorial
    c- Cant editoriales con al menos un libro de auto ayuda 

*/

Accion Parcial_Ej1B es
    AMBIENTE
        Edi, Lib, LibInfantiles: Secuencia de caracteres
        e, l: caracteres
        CantPg: entero //Cantidad de páginas de libros Infantiles
        CantPal: entero  //Cantidad de palabras por editorial
        CantAutoayuda: entero  //Cantidad Editoriales con algún libro de Autoayuda
               
        Funcion ConvDig(n:entero):entero es
          Segun n hacer
            "1" : ConvDig := 1
            "2" : ConvDig := 2
            "3" : ConvDig := 3
            "4" : ConvDig := 4
            "5" : ConvDig := 5
            "6" : ConvDig := 6
            "7" : ConvDig := 7
            "8" : ConvDig := 8
            "9" : ConvDig := 9
          Fin_segun
        Fin_Funcion

    PROCESO
        Arrancar(Edi)
        Arrancar(Lib)
        
        Avanzar(Edi, e)
        Avanzar(Lib, l)
        
        Crear(LibInfantiles)

        CantAutoayuda := 0

        Mientras NoFDS(Editoriales) entonces
            
            //Escribo nombre de editorial
            Escribir("Editorial:")

            Mientras e <> "&" hacer
                Escribir(e)
                Avanzar(Edi, e)
            Fin_Mientras
            Avanzar(Edi, e)


            //Hay libros de auto ayuda en esta editorial?
            Si l="A" entonces
                CantAutoayuda := CantAutoayuda + 1
            fin_si


            //Libros Infantiles  a)
            Si l="I" entonces
                CantPg := 0
                Avanzar(Lib, l)

                Para i=1 hasta 3 hacer      //número de páginas
                    CantPg := (CantPg * 10) + ConvDig(l)
                    Avanzar(Lib, l)
                fin_para

                Mientras (CantPg < 150) y (l <> "&") hacer
                    Escribir(LibInfantiles, l)
                    Avanzar(Lib, l)
                Fin_Mientras
            Sino 
                Mientras l<>"&" hacer
                    Avanzar(Lib, l)
                Fin_Mientras
            Fin_Si


            //Cantidad de palabras en el resumen del libro de la Editorial actual
            CantPal := 0

            Mientras l<>"#" hacer
                Si l=" " o l="." entonces
                    CantPal := CantPal + 1
                Fin_Si

                Avanzo(Lib, l)
            Fin_Mientras

            Escribir("Cantidad de palabras de resumen del libro:", CantPal)

        Fin_Mientras

        Escribir("Cantidad de Editoriales con libros de Autoayuda", CantAutoayuda)    //c)

        CERRAR(Lib)
        CERRAR(Edi)
        CERRAR(LibInfantiles)
Fin_Accion    




//* Version Segmentada en SUBACCIONES -------------------------------------------------

Accion Parcial_Ej1B es
    AMBIENTE
        Edi, Lib, LibInfantiles: Secuencia de caracteres
        e, l: caracteres
        CantPg: entero //Cantidad de páginas de libros Infantiles
        CantPal: entero  //Cantidad de palabras por editorial
        CantAutoayuda: entero  //Cantidad Editoriales con algún libro de Autoayuda
        
        Procedimiento LibInf(Lib: secuencia de caracteres, l: caracter)
            //Libros Infantiles  a)
            Si l="I" entonces
                CantPg := 0
                Avanzar(Lib, l)

                Para i=1 hasta 3 hacer      //número de páginas
                    CantPg := (CantPg * 10) + ConvDig(l)
                    Avanzar(Lib, l)
                fin_para

                Mientras (CantPg < 150) y (l <> "&") hacer
                  Escribir(LibInfantiles, l)
                  Avanzar(Lib, l)
                Fin_Mientras
            Sino 
                Mientras l<>"&" hacer
                  Avanzar(Lib, l)
                Fin_Mientras
            Fin_Si
            
        Fin_Procedimiento

    PROCESO
        Arrancar(Edi)
        Arrancar(Lib)
        
        Avanzar(Edi, e)
        Avanzar(Lib, l)
        
        Crear(LibInfantiles)

        CantAutoayuda := 0

        Mientras NoFDS(Editoriales) entonces
            
            //Escribo nombre de editorial
            Escribir("Editorial:")

            Mientras e <> "&" hacer
                Escribir(e)
                Avanzar(Edi, e)
            Fin_Mientras
            Avanzar(Edi, e)


            //Hay libros de auto ayuda en esta editorial?
            Si l="A" entonces
                CantAutoayuda := CantAutoayuda + 1
            fin_si

            //Procedimiento Libros Infantiles  a)
            Libinf(Lib, l)

            //Cantidad de palabras en el resumen del libro de la Editorial actual
            CantPal := 0

            Mientras l<>"#" hacer
                Si l=" " o l="." entonces
                    CantPal := CantPal + 1
                Fin_Si

                Avanzo(Lib, l)
            Fin_Mientras

            Escribir("Cantidad de palabras de resumen del libro:", CantPal)

        Fin_Mientras

        Escribir("Cantidad de Editoriales con libros de Autoayuda", CantAutoayuda)    //c)

        CERRAR(Lib)
        CERRAR(Edi)
        CERRAR(LibInfantiles)

Fin_Accion    
