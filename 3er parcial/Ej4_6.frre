//! Ejercicio 4.6
//* Clase 14/10/2026


/*
  	Ejercicio 4.6

 	En el restaurante ÑOQUIS se está pensando en una solución informática para el soporte de datos del nuevo sistema de atención a clientes. Se han decidido por LISTAS por su dinamismo en cuanto a la cantidad de elementos. Diseñe un algoritmo que realice las siguientes funciones:

 		- Añadir cliente al ser atendido (lista simple ordenada por Nombre del Cliente).
 		- Registrar su consumo (Acumular el Total Consumido en valores de montos).
 		- Realizar el cobro (emitir ticket con Nombre, Fecha, Número de Mesa y Total).
 		- Eliminar del listado de atención.
 
 	La información almacenada debe mantenerse ordenada por Nombre del cliente. 

*/


//Guía PDF, Complementos teórico a partir de la pág 63, algoritmo modelo para inserción en lista circular simplemente enlazada. Pg 63 también, hay un menú

//Solución @pina092033(Nehemias) en Discord, pero creo que hay cosas a ccorregir en el uso del segun. Si el usuario introduce 5 para salir le va a tirar error porque NO es una opción.
Accion ejercicio 4.6 (prim: puntero a cliente) es 
  Ambiente 
    fecha = registro 
      año: n(4)
      mes: n(2)
      dia: n(2)
    finreg 

    cliente = registro 
      nom_clie: an(25)
      total_cons: real
      fe_fact: fecha 
      nro_mesa: entero
      prox: puntero a cliente 
    finreg

    p,q,ant,aux: puntero a cliente 
    opcion: entero
    consumo: real
    nombre: an(25)

  proceso 
    p:= prim
    q:= nil
    ant:= nil
    aux:= nil

    repetir 
      P:= prim; ant:= nil
      escribir ("bienvenido, ingrese la opcion que desea ejecutar")
      escribir ("para agregar un cliente nuevo ingrese 1")
      escribir ("para ingresar su consumo ingrese 2")
      escribir ("para realizar el cobro ingrese 3")
      escribir ("para eliminar un cliente ingrese 4")
      escribir ("para finalizar ingrese 5")
      leer (opcion)

      escribir ("por favor ingrese el nombre del cliente")
      leer (nombre)

      segun opcion hacer 
        1:  nuevo (q); escribir ("ingrese numero de mesa"); leer (*q.nro_mesa)
           *q.total_cons:= 0; *q.fe_fact:= fecha_sistema(); *q.nom_clie:= nombre 
           Mientras p <> nil y *p.nom_clie < nombre hacer 
             ant:= p 
             p:= *p.prox
           finmientras 
           si p = prim entonces 
             prim:= q
             *q.prox:= p 
           sino 
             *q.prox:= p 
             *ant.prox:= q 
           finsi 

        2: escribir ("por vagor ingrese el consumo del cliente", nombre)
           leer (consumo)
           mientras p <> nil y *p.nom_clie <> nombre hacer 
             p:= *p.prox
           finmientras 
           si p = nil entonces 
             escribir ("error el cliente no existe")
           sino 
             *p.total_cons:= *p.total_cons + consumo
           finsi 

        3: mientras p <> nil y *p.nom_clie <> nombre hacer 
             p:= *p.prox
           finmientras 
           si p = nil entonces 
             escribir ("error el cliente no existe")
           sino 
             escribir ("TICKET")
             escribir ("nombre:", *p.nom_clie)
             escribir ("fecha:", *p.fe_fact)
             escribir ("numero de mesa:", *p.nro_mesa)
             escribir ("total consumido:", *p.total_cons)
           finsi 
		   
        4: mientras p <> nil y *p.nom_clie <> nombre hacer 
             ant:= P
             p:= *p.prox
           finmientras 

           si p = nil entonces 
             escribir ("error, el cliente no existe")
           sino 
             si p = prim entonces 
               prim:= *P.prox
             sino 
               *ant.prox:= *P.prox
             finsi
             disponer (P)
           finsi

      finsegun
    hasta que opcion = 5
FIN_ACCION





//Mi versión  -   lista simple, ordenada por Nombre del Cliente
Accion ejercicio 4.6 (prim: puntero a cliente) es 
  AMBIENTE 
    fecha = registro 
      año: n(4)
      mes: n(2)
      dia: n(2)
    fin_registro

    cliente = registro  //+++ de nodo +++
      nom_clie: an(25)
      total_cons: real  //Total Consumido 
      fe_fact: fecha 
      nro_mesa: entero
      prox: puntero a cliente 
    fin_registro

    p, q, ant, aux: puntero a cliente 
    opcion: entero
    nombre: an(30)
    consumo: real

    //Nuevo cliente -------------------------
    Procedimiento Nuevo_Clie(nombre: an(30), ) Es
      nuevo (q); 

      //Lo puse en el orden en el que está declarado por el bien de mi cabeza. En el caso de que asumierammos que el usuario puede introducir otra cosa que no sea un entero, talvez sería mejor ingresar primero que todo el num de mesa, da error y la compu se ahorra de hacer lo otro.
      *q.nom_clie:= nombre
      *q.total_cons:= 0
      *q.fe_fact:= fecha_sistema()

      escribir ("ingrese numero de mesa"); 
      leer (*q.nro_mesa)
      

      Mientras (p <> nil) y (*p.nom_clie < nombre) hacer 
        ant := p 
        p := *p.prox
      fin_mientras 

      Si p = prim entonces   //1er elemento  o Vacio
        prim := q 
        *q.prox := p 

      sino                  //Medio o ult
        *q.prox := p 
        *ant.prox := q 
      fin_si 
    Fin_procedimiento

    //Agregar consumo -------------------------
    Procedimiento Agregar_Consumo() Es
      escribir ("Ingrese el consumo del cliente ", nombre, ": ")
      leer (consumo)
      
      Mientras (p <> nil) y (*p.nom_clie <> nombre) hacer 
        p := *p.prox
      fin_mientras 

      Si p = nil entonces 
        escribir ("Error: cliente no existe.")
      Sino       //si  (*p.nom_clie = nombre)  entonces
        *p.total_cons:= *p.total_cons + consumo
      fin_si 
    Fin_procedimiento

    //Agregar cobro -------------------------
    Procedimiento Agregar_Cobro() Es
      Mientras (p <> nil) y (*p.nom_clie <> nombre) hacer 
        p:= *p.prox
      fin_mientras 

      Si (p = nil) entonces 
        escribir ("Error: cliente no existe.")
      Sino 
        //Emitir ticket
        escribir ("-------- TICKET --------")
        escribir ("nombre:", *p.nom_clie)
        escribir ("fecha:", *p.fe_fact)
        escribir ("numero de mesa:", *p.nro_mesa)
        escribir ("total consumido:", *p.total_cons)
        escribir ("------------------------")
      fin_si 
    Fin_procedimiento

    //Eliminar cliente -------------------------
    Procedimiento Eliminar_Cliente() Es
      Mientras p <> nil y *p.nom_clie <> nombre hacer 
        ant:= P
        p:= *p.prox
      fin_mientras 

      si p = nil entonces 
        escribir ("Error: cliente no existe.")
      sino 
        si p = prim entonces 
          prim:= *P.prox
        sino 
          *ant.prox:= *P.prox
        fin_si
        disponer (P)
      fin_si
    Fin_procedimiento


  PROCESO
    p := prim
    q := nil
    ant := nil
    aux := nil

    escribir ("Ingrese ngrese la opcion que desea ejecutar")
    escribir ("1. agregar un cliente nuevo.")
    escribir ("2. ingresar su consumo.")
    escribir ("3. realizar el cobro.")
    escribir ("4. eliminar un cliente.")
    escribir ("5. salir.")
    leer (opcion)

    escribir ("por favor ingrese el nombre del cliente")
    leer (nombre)

    Repertir            //estructura post-test,y Es indefinido(No se sabe de antemano cuántas operaciones va a querer realizar el usuario antes de elegir la opción de salir)  
      Segun opcion hacer
        1: Nuevo_Clie(nombre)  //Procedimientos
        2: Agregar_Consumo(nombre)
        3: Agregar_Cobro(nombre)
        4: Eliminar_Ciente(nombre)
        5: escribir("Hasta pronto...")
        otro: escribir("Error, opción no válida")
      Fin_segun
    Hasta que (opcion = 5)
FIN_ACCION



