        <mxCell id="SIzOqEBqoGPxTqzclkbN-193" parent="1" style="text;strokeColor=none;fillColor=none;html=1;fontSize=24;fontStyle=1;verticalAlign=middle;align=left;" value="&lt;div style=&quot;color: #f6f8f7;background-color: #25252f;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;ACCIÓN ej4_4 (prim: puntero a nodo) &lt;/span&gt;&lt;span style=&quot;color: #d58fdb;&quot;&gt;es&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;AMBIENTE&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #525863;font-style: italic;&quot;&gt;//Lista orginal&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; Lista = &lt;/span&gt;&lt;span style=&quot;color: #d58fdb;&quot;&gt;Registro&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;dato: entero&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Prox: puntero a nodo&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #d58fdb;&quot;&gt;Fin_Registro&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; P, Q, ULT: puntero a nodo&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;PROCESO&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; ULT := NIL &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; P := PRIM &lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #d58fdb;&quot;&gt;Mientras&lt;/span&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt; P &amp;lt;&amp;gt; NIL &lt;/span&gt;&lt;span style=&quot;color: #d58fdb;&quot;&gt;hacer&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Q := *P.prox&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; *P.prox := ULT&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ULT := P&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; P := Q &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; FinMientras&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #f6f8f7;&quot;&gt;&amp;nbsp; &amp;nbsp; PRIM := ULT&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #d58fdb;&quot;&gt;FIN_ACCION&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
